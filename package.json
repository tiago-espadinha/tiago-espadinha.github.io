{
  "name": "personal-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "locales": "node scripts/check-locales.mjs",
    "check": "npm run lint && npm run format:check && npm run locales",
    "cv": "make -C cv",
    "cv:en": "make -C cv en",
    "cv:pt": "make -C cv pt",
    "cv:clean": "make -C cv clean",
    "clips": "node scripts/record-clips.mjs"
  },
  "devDependencies": {
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0"
  }
}
